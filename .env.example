# TravelHub Environment Example
# قم بنسخ هذا الملف إلى .env ثم عدّل القيم

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/travelhub
JWT_SECRET=travelhub-super-secret-key-change-me
JWT_EXPIRE=7d

# WhatsApp
WHATSAPP_NUMBER=966500000000
NOTIFY_NUMBER=966500000000
SESSION_PATH=./session

# Optional
PUPPETEER_EXECUTABLE_PATH=
